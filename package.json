  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "preset",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Lz020316/dsh-game-theory-coach.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
